#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Velocidade do mouse na camada ADJUST (padrão ZMK é 600) — aumentada para movimento mais ágil
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define GAMER 4
#define TURBO_HOLD 5
#define TURBO_MOUSE 6

// Velocidade turbo do mouse (segurar T dentro da ADJUST) — bem mais rápido que o padrão
#define TURBO_MOVE_VAL 3000

/ {
    macros {
        // Screenshot de seleção no Windows (Win+Shift+S - Ferramenta de Captura)

        Print_Selection: Print_Selection {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(S))>;
            label = "PRINT_SELECTION";
        };

        // Acute_Accent removido - acento agudo real é LEFT_BRACKET em PT-BR
    };

    combos {
        compatible = "zmk,combos";

        // COMBO ORIGINAL: F + J = toggle gamer mode

        combo_gamer_toggle {
            timeout-ms = <50>;
            key-positions = <28 31>; // F + J positions (28=F, 31=J)
            bindings = <&tog 4>; // Toggle layer 4 (gamer)
            layers = <0>; // Só funciona na camada base
        };
    };

    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };

        // Segurar T dentro da ADJUST ativa velocidade turbo no I/J/K/L
        turbo_mouse_layer {
            if-layers = <LOWER RAISE TURBO_HOLD>;
            then-layer = <TURBO_MOUSE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   [   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                  &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &kp LEFT_BRACKET
&kp ESC    &kp Q   &kp W     &kp E     &kp R      &kp T                                   &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                                   &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B      &kp C_MUTE    &kp LC(LG(Q))  &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &kp LCTRL  &mo LOWER  &kp RET       &kp SPACE      &mo RAISE  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";

            // LAYER ORIGINAL RESTAURADA - Símbolos + Mídia + Gamer Toggle
            // ------------------------------------------------------------------------------------------------------------
            // |  GAMER|  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   | PREV|  -  |  +   |  (   |  )   |                   |  (   |   )   |   +   |  -   |  NEXT |  F12  |
            // |       |  !  |  /  |  *   |  [   |  ]   |                   |  [   |   ]   |   *   |  /   |   !   |   |   |
            // |       |  =  |  {  |  }   |  _   |  =   | EMOJI  |  | PLAY  | DEL  |   {   |   }   |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&tog 4     &kp F1          &kp F2          &kp F3           &kp F4                &kp F5                                                &kp F6                &kp F7                 &kp F8           &kp F9     &kp F10          &kp F11
&kp GRAVE  &kp C_PREVIOUS  &kp MINUS       &kp PLUS         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                                 &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS         &kp MINUS  &kp C_NEXT       &kp F12
&trans     &kp EXCL        &kp SLASH       &kp ASTERISK     &kp LEFT_BRACKET      &kp RIGHT_BRACKET                                     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp ASTRK        &kp SLASH  &kp EXCLAMATION  &kp PIPE
&trans     &kp EQUAL       &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp UNDER             &kp EQUAL              &kp LC(LG(SPACE))  &kp C_PLAY_PAUSE  &kp DEL               &kp LEFT_BRACE         &kp RIGHT_BRACE  &kp COLON  &kp BSLH         &trans
                           &trans          &trans           &trans                &trans                 &trans       &trans            &trans                &trans                 &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "arise";

            // LAYER ORIGINAL RESTAURADA - BT + Navegação + Clipboard + Seleção
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                | USB  | BLE  |       |      |       |       |
            // |       |  /   |  ?   | LANG  |       |      |                | PGUP | HOME |   ^   | END  |   0   |       |
            // |       |Ctrl+A| CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       |Ctrl+Z|Ctrl+X|Ctrl+C |Ctrl+V |Redo  |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &out OUT_USB  &out OUT_BLE  &trans    &trans     &trans   &trans
&trans      &kp SLASH     &kp QMARK     &kp LG(SPACE) &trans        &trans                          &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp N0   &trans
&trans      &kp LC(A)     &kp LCTRL     &kp LSHFT     &trans        &kp CLCK                        &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans      &kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(LS(Z)) &trans    &trans  &trans     &trans    &trans    &trans     &trans   &trans
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1  |  BT2  |  BT3  |  BT4  |  BT5  |                  |         |         |         |          |       |       |
            // |        |       |       |       |  TURBO|       |                  | SCR_UP  | LCLICK  | MOV_UP  | RCLICK   |       |       |
            // |        |       |       |       |       |       |                  | SCR_DN  |MOV_LEFT | MOV_DN  | MOV_RIGHT|       |       |
            // |        |       |       |       |       |       |         |  |     |         |         |         |          |       |       |
            //                  |       |       |       |       |         |  |     |         |         |         |          |

            display-name = "adjust";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &none          &none          &none         &none           &none  &none
&none       &none         &none         &none         &none         &mo TURBO_HOLD                 &msc SCRL_UP   &mkp LCLK      &mmv MOVE_UP  &mkp RCLK       &none  &none
&none       &none         &none         &none         &none         &none                          &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
&none       &none         &none         &none         &none         &none         &none      &none  &none          &none          &none         &none           &none  &none
                          &none         &none         &none         &none         &none      &none  &none          &none          &none         &none
            >;
        };

        gamer_layer {
            display-name = "gamer";

            // 🎮 CAMADA GAMER - Space e Enter TROCADOS + acesso às outras layers
            // F + J = volta para layer base OU liga/desliga gamer
            // ------------------------------------------------------------------------------------------------------------
            // |  BASE |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   [   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |LOCK   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER| SPACE  | | ENTER | RAISE| CTRL  | ALT   | GUI  |
            //                                          ↑ SPACE e ENTER trocados! ↑
            // Demais teclas são &trans: com LOWER/RAISE seguradas, acessa F-keys, BT, setas etc. da BASE

            bindings = <
&to BASE   &trans  &trans    &trans    &trans     &trans                                     &trans     &trans     &trans     &trans    &trans    &trans
&trans     &trans  &trans    &trans    &trans     &trans                                     &trans     &trans     &trans     &trans    &trans    &trans
&trans     &trans  &trans    &trans    &trans     &trans                                     &trans     &trans     &trans     &trans    &trans    &trans
&trans     &trans  &trans    &trans    &trans     &trans     &trans        &Print_Selection  &trans     &trans     &trans     &trans    &trans    &trans
                   &trans    &trans    &trans     &mo LOWER  &kp SPACE     &kp RET           &mo RAISE  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        turbo_hold_layer {
            // Camada auxiliar: existe só para servir de "gatilho" (segurar T na ADJUST) da
            // turbo_mouse_layer condicional abaixo. Não tem bindings próprios.
            display-name = "turbo-hold";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
            >;
        };

        turbo_mouse_layer {
            // Ativada quando LOWER+RAISE+T (turbo_hold) estão todos segurados.
            // Só sobrescreve I/J/K/L com velocidade turbo; resto cai (trans) pra ADJUST.
            display-name = "turbo-mouse";

            // ----------------------------------------------------------------------------------------------------
            // |        |       |       |       |       |       |                  |         |         |         |          |       |       |
            // |        |       |       |       |       |       |                  |         |         |TURBO_UP |          |       |       |
            // |        |       |       |       |       |       |                  |         |TURBO_LFT|TURBO_DN |TURBO_RGT |       |       |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                       &trans  &trans                       &trans                      &trans                      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                       &trans  &trans                       &mmv MOVE_Y(-TURBO_MOVE_VAL) &trans                      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                       &trans  &mmv MOVE_X(-TURBO_MOVE_VAL) &mmv MOVE_Y(TURBO_MOVE_VAL)  &mmv MOVE_X(TURBO_MOVE_VAL) &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans                    &trans  &trans                       &trans                      &trans                      &trans  &trans
                &trans  &trans  &trans  &trans  &trans     &trans                    &trans  &trans                       &trans                      &trans
            >;
        };
    };
};

// Rampa até velocidade máxima mais curta (padrão ZMK é 300ms) — resposta mais ágil
&mmv {
    time-to-max-speed-ms = <150>;
};
